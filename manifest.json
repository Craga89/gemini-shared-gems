{
  "manifest_version": 3,
  "version": "1.0.0",
  "name": "Gemini Shared Gems Manager",
  "description": "Lists shared Gems directly in the Gemini sidebar",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "identity",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "305210669523-1igl6edrh0jdfoot8nv4tvv8ege308rh.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.metadata.readonly"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content.js"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ]
    }
  ]
}
