{
  "name": "gemini-shared-gems-manager",
  "version": "1.0.0",
  "description": "Lists shared Gems directly in the Gemini sidebar",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "release": "pnpm build && cd dist && zip -r ../bundle.zip . && cd ..",
    "upload": "webstore upload --source bundle.zip --extension-id $CHROME_EXTENSION_ID --client-id $CHROME_CLIENT_ID --client-secret $CHROME_CLIENT_SECRET --refresh-token $CHROME_REFRESH_TOKEN"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "chrome-webstore-upload-cli": "^3.5.0",
    "vite": "^5.0.0"
  }
}
